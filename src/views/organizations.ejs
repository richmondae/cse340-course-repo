<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach((organization) => { %>
            <li>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                <span>
                    <strong><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></strong><br>
                    <%= organization.description %><br>
                    <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                </span>
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>
