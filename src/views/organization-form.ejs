<%- include('partials/header') %>
<main id="main-content" class="form-page">
    <h1><%= title %></h1>
    <form method="post" action="<%= organization.organization_id ? `/edit-organization/${organization.organization_id}` : '/new-organization' %>">
        <label for="name">Organization name</label>
        <input id="name" name="name" type="text" value="<%= organization.name || '' %>" maxlength="150" required>

        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" maxlength="500" required><%= organization.description || '' %></textarea>

        <label for="contact_email">Contact email</label>
        <input id="contact_email" name="contact_email" type="email" value="<%= organization.contact_email || '' %>" maxlength="255" required>

        <label for="logo_filename">Organization logo</label>
        <select id="logo_filename" name="logo_filename" required>
            <option value="">Choose a logo</option>
            <% [{ filename: 'brightfuture-logo.svg', label: 'BrightFuture Builders' }, { filename: 'greenharvest-logo.svg', label: 'GreenHarvest Growers' }, { filename: 'unityserve-logo.svg', label: 'UnityServe Volunteers' }].forEach((logo) => { %>
                <option value="<%= logo.filename %>" <%= organization.logo_filename === logo.filename ? 'selected' : '' %>><%= logo.label %></option>
            <% }) %>
        </select>
        <div class="form-actions">
            <button type="submit"><%= organization.organization_id ? 'Save organization' : 'Create organization' %></button>
            <a href="/organizations">Cancel</a>
        </div>
    </form>
</main>
<%- include('partials/footer') %>
