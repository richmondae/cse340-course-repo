<%- include('partials/header') %>

<main id="main-content" class="detail-page">
    <h1><%= categoryDetails.name %></h1>
    <h2>Projects in this category</h2>
    <% if (projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach((project) => { %>
                <li>
                    <p><%= project.formatted_date %>: <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a></p>
                    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No projects are currently assigned to this category.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
