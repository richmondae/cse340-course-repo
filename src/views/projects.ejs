<%- include('partials/header') %>

<main id="main-content">
    <h1><%= title %></h1>

    <ul class="project-list">
        <% projects.forEach((project) => { %>
            <li>
                <p><%= project.formatted_date %>: <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
                    (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
                </p>
                <p><%= project.description %></p>
                <p><strong>Location:</strong> <%= project.location %></p>
            </li>
        <% }) %>
    </ul>
    <% if (projects.length === 0) { %>
        <p>There are no service projects to display yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
