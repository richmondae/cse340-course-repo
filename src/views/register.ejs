<%- include('partials/header') %>

<main id="main-content" class="form-page auth-page">
    <h1>Create an Account</h1>
    <p>Register to access your service network dashboard.</p>
    <form method="post" action="/register">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" value="<%= formData.name || '' %>" maxlength="100" required autocomplete="name">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= formData.email || '' %>" maxlength="100" required autocomplete="email">

        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="6" maxlength="72" required autocomplete="new-password">

        <button type="submit">Register</button>
    </form>
    <p>Already registered? <a href="/login">Log in</a>.</p>
</main>

<%- include('partials/footer') %>
